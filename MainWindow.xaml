<Window x:Class="QwenPaw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QwenPaw" Height="850" Width="1280"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#18181b">
    <Grid>
        <wv2:WebView2 Name="webView" />
        <ProgressBar Name="progressBar" Height="3" VerticalAlignment="Top" 
                     IsIndeterminate="True" Visibility="Visible" Foreground="#3b82f6" BorderThickness="0" Background="Transparent" />
    </Grid>
</Window>
